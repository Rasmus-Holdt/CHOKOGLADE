<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ChokoGlade — Italiensk café i Ribe | Antipasti, aperitivo og kaffe</title>
<meta name="description" content="Italiensk café på Nederdammen 32 i Ribe. Antipasti, aperitivo, illy-kaffe og chokolade fra Piemonte. Drevet af Giacomo og Eleonora, der flyttede fra Milano til Ribe.">

<!--
  ============================================================
  CHOKOGLADE — index.html
  Én fil. Ingen build, ingen framework, ingen eksterne kald.
  Bare læg filen på en webserver.

  ------------------------------------------------------------
  SÅDAN SKIFTER DU BILLEDER IND
  ------------------------------------------------------------
  Læg billedfilerne i en mappe der hedder "billeder" ved siden
  af denne fil. Find så blokken :root { --img-... } nedenfor og
  udskift none med url("billeder/filnavn.jpg").

  Eksempel:
     --img-facade: url("billeder/facade.jpg");

  Der er 6 pladser. Se billeder-guide.md for hvad hver enkelt
  skal forestille og hvilket format den skal have.

  ------------------------------------------------------------
  SKAL BEKRÆFTES FØR SIDEN GÅR LIVE
  ------------------------------------------------------------
  1. ÅBNINGSTIDER. Tiderne nedenfor stammer fra Ryk Ind Ribes
     åbningsartikel, 23. april 2024. De er sandsynligvis
     forældede nu hvor der er køkken og servering.
     Søg efter data-check="aabningstider" og ret dem.

  2. GELATO. Fremgår af deres skiltevogn på gågaden, ikke af
     nogen skriftlig kilde. Søg efter data-check="gelato".
     Slet blokken hvis de ikke sælger is.

  3. WOLT. De har en Wolt-side, men det er ikke bekræftet at
     den er aktiv. Søg efter data-check="wolt".

  Alt andet på siden er verificeret mod kilder.
  ============================================================
-->

<style>
:root{
  /* ---- BILLEDER: udskift none med url("billeder/...") ---- */
  --img-facade:  none;   /* Facade fra brostensgaden */
  --img-plate1:  none;   /* Antipasti-tallerken, tæt på */
  --img-plate2:  none;   /* Antipasti udendørs m. vin og Peroni */
  --img-team:    none;   /* Giacomo og Eleonora / personalet */
  --img-street:  none;   /* Gågaden med skiltevognen */
  --img-inside:  none;   /* Interiør */

  /* ---- Farver ---- */
  --cocoa:   #3B2314;
  --cocoa-d: #241109;
  --cream:   #F5EFE6;
  --cream-d: #EAE0D2;
  --gold:    #B08D57;
  --gold-l:  #C9A870;
  --ink:     #2A1810;
  --muted:   #6E5646;
  --line:    rgba(59,35,20,.14);

  --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;

  --wrap: 1080px;
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;
  font-family:var(--sans);
  font-size:17px;
  line-height:1.65;
  color:var(--ink);
  background:var(--cream);
}
img{max-width:100%;display:block}
a{color:inherit}

h1,h2,h3{font-family:var(--serif);font-weight:400;line-height:1.15;margin:0}
h1{font-size:clamp(2.5rem,7vw,4.4rem);letter-spacing:-.01em}
h2{font-size:clamp(1.75rem,4.2vw,2.6rem)}
h3{font-size:1.2rem}
p{margin:0 0 1rem}

.wrap{max-width:var(--wrap);margin:0 auto;padding:0 24px}
section{padding:76px 0}

/* ---- Chokoladeplade-tekstur ---- */
/* Rudemønsteret fra en brækket chokoladeplade. Meget lav kontrast
   — det skal føles som en overflade, ikke ses som et mønster. */
.bar-texture{
  position:absolute;inset:0;pointer-events:none;
  background-image:
    linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px),
    linear-gradient(rgba(0,0,0,.07) 1px, transparent 1px);
  background-size:74px 74px;
  opacity:.5;
}
.bar-texture.on-light{
  background-image:
    linear-gradient(90deg, rgba(59,35,20,.05) 1px, transparent 1px),
    linear-gradient(rgba(59,35,20,.05) 1px, transparent 1px);
}

/* ---- Topbar ---- */
.topbar{
  position:sticky;top:0;z-index:60;
  background:rgba(36,17,9,.94);
  backdrop-filter:saturate(150%) blur(8px);
  border-bottom:1px solid rgba(176,141,87,.28);
}
.topbar .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:11px;padding-bottom:11px}
.brand{font-family:var(--serif);color:var(--cream);font-size:1.22rem;letter-spacing:.02em;text-decoration:none}
.brand b{color:var(--gold-l);font-weight:400}
.langs{display:flex;gap:2px;background:rgba(245,239,230,.09);border-radius:999px;padding:3px}
.langs button{
  font:inherit;font-size:.76rem;font-weight:600;letter-spacing:.06em;
  border:0;background:transparent;color:rgba(245,239,230,.62);
  padding:5px 11px;border-radius:999px;cursor:pointer;transition:.18s;
}
.langs button:hover{color:var(--cream)}
.langs button[aria-pressed="true"]{background:var(--gold);color:var(--cocoa-d)}

/* ---- Knapper ---- */
.btn{
  display:inline-flex;align-items:center;gap:9px;
  font-size:1rem;font-weight:600;text-decoration:none;
  padding:15px 28px;border-radius:3px;border:1.5px solid transparent;
  transition:.18s;white-space:nowrap;
}
.btn-gold{background:var(--gold);color:var(--cocoa-d)}
.btn-gold:hover{background:var(--gold-l)}
.btn-ghost{border-color:rgba(245,239,230,.45);color:var(--cream)}
.btn-ghost:hover{border-color:var(--cream);background:rgba(245,239,230,.09)}
.btn-dark{background:var(--cocoa);color:var(--cream)}
.btn-dark:hover{background:var(--cocoa-d)}

/* ---- Hero ---- */
.hero{position:relative;background:var(--cocoa-d);color:var(--cream);overflow:hidden;padding:0}
.hero-grid{display:grid;grid-template-columns:1fr;gap:0}
.hero-copy{padding:64px 0 68px;position:relative;z-index:2}
.hero h1{color:var(--cream)}
.hero h1 em{font-style:normal;color:var(--gold-l)}
.kicker{
  font-size:.78rem;font-weight:700;letter-spacing:.17em;text-transform:uppercase;
  color:var(--gold-l);margin:0 0 20px;
}
.hero-lede{font-size:1.16rem;color:rgba(245,239,230,.82);max-width:46ch;margin:22px 0 34px}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px}
.hero-img{
  position:relative;min-height:300px;
  background-color:#1B0D06;
  background-image:var(--img-facade);
  background-size:cover;background-position:center;
}

/* ---- Billed-placeholder ---- */
.ph{
  position:absolute;inset:0;
  display:flex;align-items:center;justify-content:center;
  text-align:center;padding:20px;
  font-size:.72rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;
  color:rgba(176,141,87,.85);
  background:
    repeating-linear-gradient(-45deg, rgba(176,141,87,.07) 0 12px, transparent 12px 24px),
    #241109;
  border:1px dashed rgba(176,141,87,.4);
}
.ph.light{color:rgba(59,35,20,.5);background:
    repeating-linear-gradient(-45deg, rgba(59,35,20,.05) 0 12px, transparent 12px 24px),
    var(--cream-d);
  border-color:rgba(59,35,20,.22);}
/* Placeholderen skjules af scriptet nederst, når billedet er sat ind */
.ph[hidden]{display:none}

/* ---- Menu ---- */
.section-head{max-width:56ch;margin-bottom:44px}
.section-head p{color:var(--muted);font-size:1.06rem;margin:14px 0 0}
.menu{display:grid;grid-template-columns:1fr;gap:1px;background:var(--line);border:1px solid var(--line);counter-reset:item}
.item{background:var(--cream);padding:30px 28px;counter-increment:item}
/* Numrene tælles af CSS. Sletter du et menupunkt, renummererer resten sig selv. */
.item::before{
  content:counter(item,decimal-leading-zero);
  font-family:var(--serif);font-size:.9rem;color:var(--gold);
  display:block;margin-bottom:10px;
}
.item h3{margin-bottom:8px}
.item p{color:var(--muted);font-size:.97rem;margin:0}

/* ---- Galleri ---- */
.gallery{display:grid;grid-template-columns:1fr;gap:14px;margin-top:44px}
.shot{position:relative;aspect-ratio:4/3;background-size:cover;background-position:center;background-color:var(--cream-d)}
.shot.a{background-image:var(--img-plate1)}
.shot.b{background-image:var(--img-plate2)}
.shot.c{background-image:var(--img-inside)}

/* ---- Historien ---- */
.story{background:var(--cocoa);color:var(--cream);position:relative;overflow:hidden}
.story h2{color:var(--cream)}
.story .section-head p{color:rgba(245,239,230,.72)}
.story-grid{display:grid;grid-template-columns:1fr;gap:40px;position:relative;z-index:2}
.story-text p{color:rgba(245,239,230,.82)}
.quote{
  font-family:var(--serif);font-size:1.3rem;line-height:1.5;
  color:var(--gold-l);border-left:2px solid var(--gold);
  padding-left:22px;margin:28px 0 0;
}
.quote cite{
  display:block;font-family:var(--sans);font-style:normal;
  font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;
  color:rgba(245,239,230,.5);margin-top:12px;
}
.story-img{
  position:relative;aspect-ratio:3/4;min-height:280px;
  background-image:var(--img-team);background-size:cover;background-position:center;
  background-color:#1B0D06;
}

/* ---- Besøg os ---- */
.visit-grid{display:grid;grid-template-columns:1fr;gap:38px}
.facts{border-top:2px solid var(--ink)}
.fact{display:grid;grid-template-columns:118px 1fr;gap:16px;padding:16px 0;border-bottom:1px solid var(--line);align-items:baseline}
.fact dt{font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.fact dd{margin:0;font-size:1.04rem}
.fact dd a{text-decoration:none;border-bottom:1.5px solid var(--gold)}
.fact dd a:hover{background:rgba(176,141,87,.16)}
.hours{margin:0;font-variant-numeric:tabular-nums}
.hours div{display:flex;justify-content:space-between;gap:20px;padding:9px 0;border-bottom:1px solid var(--line);max-width:330px}
.hours div:last-child{border-bottom:0}
.hours span:first-child{color:var(--muted)}
.hours .shut{color:var(--muted)}
.visit-img{position:relative;aspect-ratio:1/1;background-image:var(--img-street);background-size:cover;background-position:center;background-color:var(--cream-d)}
.badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.badge{
  font-size:.82rem;font-weight:600;padding:8px 15px;
  border:1.5px solid var(--line);border-radius:999px;
  text-decoration:none;color:var(--muted);transition:.18s;
}
.badge:hover{border-color:var(--gold);color:var(--ink)}
.visit-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}

/* ---- Footer ---- */
footer{background:var(--cocoa-d);color:rgba(245,239,230,.6);padding:44px 0 100px;font-size:.88rem}
footer .wrap{display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:center}
footer a{color:rgba(245,239,230,.6)}

/* ---- Sticky ring-bar på mobil ---- */
.callbar{
  position:fixed;left:0;right:0;bottom:0;z-index:70;
  display:flex;border-top:1px solid rgba(245,239,230,.2);
}
.callbar a{
  flex:1;text-align:center;text-decoration:none;
  padding:16px 8px;font-size:1rem;font-weight:700;
}
.callbar .call{background:var(--gold);color:var(--cocoa-d)}
.callbar .map{background:var(--cocoa-d);color:var(--cream)}

/* ---- Desktop ---- */
@media (min-width:760px){
  section{padding:104px 0}
  .menu{grid-template-columns:repeat(2,1fr)}
  .gallery{grid-template-columns:repeat(3,1fr)}
  .visit-grid{grid-template-columns:1.25fr 1fr;gap:56px;align-items:start}
}
@media (min-width:980px){
  .hero-grid{grid-template-columns:1.08fr .92fr;align-items:stretch}
  .hero-copy{padding:112px 0 116px}
  .hero-img{min-height:560px}
  .story-grid{grid-template-columns:1.15fr .85fr;gap:64px;align-items:center}
  .menu{grid-template-columns:repeat(3,1fr)}
  .callbar{display:none}
  footer{padding-bottom:44px}
}

/* ---- Tilgængelighed ---- */
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>

